      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 55
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: COMMANDER
      text: Copy, Flight. No pressure, then.
      hold: 0
    - speaker: FLIGHT DIRECTOR
