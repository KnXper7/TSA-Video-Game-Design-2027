        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 50
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: FLIGHT DIRECTOR
      text: All stations, this is Flight. Fourteen months out, and this is it. Final approach to Planet X.
      hold: 0
    - speaker: CONTROLLER
      text: Telemetry is green across the board, Flight.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 538371708}
