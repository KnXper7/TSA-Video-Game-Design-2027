  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2186c561256e1458ea35fd39d42cda3a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TSAGame.CutsceneDirector
  cutsceneCamera: {fileID: 700418878}
  playOnStart: 1
  fadeInDuration: 2
  skipHoldSeconds: 1
  shots:
  - name: 1 Establishing
    from: {fileID: 529873938}
    to: {fileID: 1672176650}
    duration: 7
    ease:
      serializedVersion: 2
      m_Curve:
      - serializedVersion: 3
        time: 0
        value: 0
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      - serializedVersion: 3
        time: 1
        value: 1
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 50
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: FLIGHT DIRECTOR
      text: All stations, this is Flight. Fourteen months out, and this is it. Final approach to Planet X.
      hold: 0
    - speaker: CONTROLLER
      text: Telemetry is green across the board, Flight.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 600548392}
          m_TargetAssemblyTypeName: TSAGame.RocketFlight, Assembly-CSharp
          m_MethodName: BeginApproach
          m_Mode: 0
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: 
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
  - name: 2 Main Screen
    from: {fileID: 681511006}
    to: {fileID: 746149635}
    duration: 6
    ease:
      serializedVersion: 2
      m_Curve:
      - serializedVersion: 3
        time: 0
        value: 0
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      - serializedVersion: 3
        time: 1
        value: 1
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 50
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: FLIGHT DIRECTOR
      text: Commander, you're forty thousand kilometers out. The whole world is watching you.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls: []
  - name: 3 Rocket
    from: {fileID: 1915866748}
    to: {fileID: 126455490}
    duration: 7
    ease:
      serializedVersion: 2
      m_Curve:
      - serializedVersion: 3
        time: 0
        value: 0
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      - serializedVersion: 3
        time: 1
        value: 1
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 55
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: COMMANDER
      text: Copy, Flight. No pressure, then.
      hold: 0
    - speaker: FLIGHT DIRECTOR
      text: None at all. Bring it home.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls: []
  - name: 4 Alarm
    from: {fileID: 262236281}
    to: {fileID: 18604463}
    duration: 6
    ease:
      serializedVersion: 2
      m_Curve:
      - serializedVersion: 3
        time: 0
        value: 0
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      - serializedVersion: 3
        time: 1
        value: 1
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 50
    shake: 0.01
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: CONTROLLER
      text: Flight, I've got a gravity spike. Right in front of the rocket.
      hold: 0
    - speaker: CONTROLLER
      text: That's not possible. There's nothing there.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 667937452}
          m_TargetAssemblyTypeName: TSAGame.AlarmLights, Assembly-CSharp
          m_MethodName: Trigger
