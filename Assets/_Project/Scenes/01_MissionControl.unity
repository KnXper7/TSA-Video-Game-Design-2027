        value: 1
        inSlope: 0
        outSlope: 0
        tangentMode: 0
        weightedMode: 0
        inWeight: 0
        outWeight: 0
      m_PreInfinity: 2
      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 50
    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: FLIGHT DIRECTOR
      text: Commander, you're forty thousand kilometers out. The whole world is watching you.
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls: []
