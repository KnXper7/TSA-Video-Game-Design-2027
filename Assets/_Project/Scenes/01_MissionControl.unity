    shake: 0
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: CONTROLLER
      text: Telemetry's gone. Flight... we've lost the signal.
      hold: 0
    - speaker: FLIGHT DIRECTOR
      text: Rocket, this is Flight. Do you read?
      hold: 0
