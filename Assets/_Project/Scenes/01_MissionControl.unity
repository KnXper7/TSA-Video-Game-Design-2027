      m_PostInfinity: 2
      m_RotationOrder: 4
    fieldOfView: 45
    shake: 0.08
    waitForLines: 1
    linesDelay: 0.3
    lines:
    - speaker: COMMANDER
      text: "Flight, there's something in front of me. A ring... it's opening. I can't pull up\u2014"
      hold: 0
    onStart:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 575753499}
          m_TargetAssemblyTypeName: TSAGame.GateRing, Assembly-CSharp
          m_MethodName: Open
          m_Mode: 0
