    from: {fileID: 1976335828}
    to: {fileID: 1141740446}
    duration: 6
    ease:
      serializedVersion: 2
      m_Curve:
      - serializedVersion: 3
        time: 0
        value: 0
        inSlope: 0
        outSlope: 0
        tangentMode: 0
